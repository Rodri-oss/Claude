# SceneForge AI configuration. Copy to .env.local (web) — the worker also reads .env.local / .env.
# Never commit real keys.

# Where projects, shared assets, exports and the SQLite DB live (default: ./data)
SCENEFORGE_DATA_DIR=./data

# Hard safety switch. Real paid providers refuse to submit unless this is "true".
# Mock mode is the default for development.
SCENEFORGE_ALLOW_PAID_PROVIDERS=false

# Max upload size in megabytes
SCENEFORGE_MAX_UPLOAD_MB=500

# Optional: override the browser used by Remotion for rendering
# (auto-detected: Playwright chrome-headless-shell, then Remotion's own download)
# SCENEFORGE_BROWSER_EXECUTABLE=/path/to/chrome-headless-shell

# Optional binaries (auto-detected on PATH)
# FFMPEG_PATH=ffmpeg
# FFPROBE_PATH=ffprobe
# ESPEAK_PATH=espeak-ng

# --- Phase 2 providers (not active in Phase 1; adapters are stubs) ---
# FAL_KEY=
# ELEVENLABS_API_KEY=
# RUNWAY_API_KEY=
# ANTHROPIC_API_KEY=
