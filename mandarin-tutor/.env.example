# SQLite file (relative to prisma/). In production use a persistent volume, e.g. file:/data/app.db
DATABASE_URL="file:./dev.db"

# Your email. Signing in with it unlocks /admin (and keeps your Phase 1 progress).
ADMIN_EMAIL="you@example.com"

# Public base URL used in sign-in emails (defaults to the request's origin).
# APP_URL="https://your-app.fly.dev"

# Email delivery for magic links: set ONE of these. With neither, links are printed
# to the server console and shown on the login page in development.
# RESEND_API_KEY="re_..."
# SMTP_URL="smtps://user:pass@smtp.example.com:465"
# EMAIL_FROM="Taiwan Tutor <login@yourdomain.com>"
